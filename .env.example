# Thiết lập các biến này trong Render / Railway / máy chủ.
NODE_ENV=production
PORT=3000

# Khuyến nghị gắn Render Persistent Disk tại /var/data/nexchat.
# Toàn bộ tài khoản, phiên, tệp tải lên, bản sao lưu và khóa tự sinh sẽ nằm tại đây.
DATA_DIR=/var/data/nexchat

# Không dùng giá trị mặc định trên môi trường công khai.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=thay-bang-mat-khau-quan-tri-manh
ADMIN_SECOND_PASSWORD=thay-bang-mat-khau-cap-2-khac
ADMIN_AUDIT_DELETE_PASSWORD=thay-bang-mat-khau-xoa-nhat-ky-rieng

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự. Ví dụ: openssl rand -hex 48
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-rat-dai

# 0 = không giới hạn. Có thể tiếp tục chỉnh trong trang quản trị.
MAX_ACCOUNTS=1000

# Thông báo nền Web Push. Hãy dùng một cặp khóa cố định để đăng ký không mất sau deploy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Chỉ dùng tạm khi phát triển cục bộ. Không bật trên Render công khai.
ALLOW_INSECURE_DEFAULT_ADMIN=false

# Quota per user and total attachment metadata quota (bytes).
MAX_USER_UPLOAD_BYTES=524288000
MAX_TOTAL_UPLOAD_BYTES=5368709120

# SMS recovery is disabled safely until Twilio Verify is configured.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-a-secret-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
